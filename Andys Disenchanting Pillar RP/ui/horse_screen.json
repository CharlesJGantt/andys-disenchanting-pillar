  },
  "adp_empty_slot_background": {
    "type": "panel"
  },
  "adp_page_item@common.container_item": {
    "$item_collection_name": "container_items",
    "$background_images": "horse.adp_empty_slot_background",
    "$cell_overlay_ref": "horse.adp_empty_slot_background"
  },
  "adp_choice_row": {
    "type": "panel",
    "size": [154, 18],
    "controls": [
      {
        "choice_slot@common.container_item": {
          "$item_collection_name": "container_items",
          "size": [154, 18],
          "$cell_image_size": [154, 18],
          "$item_renderer_panel_size": [154, 18],
          "$item_renderer_size": [16, 16],
          "$item_renderer_offset": [-68, 0]
        }
      },
      {
        "row_name": {
          "type": "label",
          "size": [130, 18],
          "offset": [22, 0],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "text": "#hover_text",
          "text_alignment": "left",
          "font_scale_factor": 0.75,
          "shadow": true,
          "localize": false,
          "layer": 20,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "container_items"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "container_items",
              "binding_name": "#hover_text"
            }
          ]
        }
      }
    ]
  },
  "adp_slot_holder": {
    "type": "panel",
    "ignored": true
  },
